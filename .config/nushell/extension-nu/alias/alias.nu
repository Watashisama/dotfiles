# alias rn = reboot

alias sn = shutdown --poweroff now
alias rec = asciinema rec
alias play = asciinema play
alias mount = udisksctl mount
alias unmount = udisksctl unmount
alias i-use-arch = pacman
alias i-use-arch-btw = sudo pacman
alias e  = exit
alias q  = exit
alias l = ls
alias ll = ls -l
alias la = ls -a
alias cd-device = cd /run/user/1000/gvfs/
alias v = nvim
alias t = tmux
alias ta = tmux attach
alias b = btop
alias x = clear
alias d = deactivate
alias boo = ghostty +boo
alias f = fastfetch
alias tree = tree -C
alias copy = wl-copy 
alias paste = wl-paste 
alias record  = wl-screenrec --low-power=off

alias lazy = lazygit
alias music = rmpc
alias : = start-hyprland
alias bye = systemctl poweroff --now

# alias qu = qutebrowser
