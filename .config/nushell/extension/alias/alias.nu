# alias rn = reboot

alias arec = asciinema rec
alias aplay = asciinema play
alias mount = udisksctl mount
alias unmount = udisksctl unmount
alias nano = nvim
# alias i-use-arch = pacman
# alias i-use-arch-btw = sudo pacman
alias e  = exit
alias l = ls
alias ll = ls -l
alias la = ls -a
alias v = nvim
alias t = tmux
alias ta = tmux attach
alias b = btop
alias x = clear --keep-scrollback
alias d = deactivate
alias boo = ghostty +boo
alias f = fastfetch
alias tree = tree -C
alias copy = wl-copy 
alias paste = wl-paste 
alias record  = wl-screenrec --low-power=off

# alias lazy = lazygit
alias music = rmpc
alias s = start-hyprland
alias bye = systemctl poweroff --now


