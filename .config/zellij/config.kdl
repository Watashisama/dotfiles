ui {
  pane_frames {
    hide_session_name true
  }
}
env {
  PLUXER "zellij"
}

// Options
mouse_mode false
default_layout "compact"
simplified_ui true
copy_command "wl-copy"
show_startup_tips false
theme "isekai-remastered"
pane_frames true
pane_frame_style "full"
osc8_hyperlinks true
// session_name "test"

//layout
// layout {
//   pane size=1 borderless=false {
//     plugin location="tab-bar"
//   }
//   pane borderless=false
//   pane size=1 borderless=true {
//     plugin location="status-bar"
//   }
// }

// keybinds
keybinds clear-defaults=true {
  normal {
    bind "Alt s" { SwitchToMode "locked"; }
    bind "Alt q" { SwitchToMode "pane"; }
    bind "Alt a" { SwitchToMode "scroll"; }
    bind "Alt d" { Detach; }
    bind "Alt f" { ToggleFloatingPanes; }
    bind "Alt p" { TogglePanePinned; SwitchToMode "normal"; }
    bind "Alt h" { MoveFocus "left"; }
    bind "Alt l" { MoveFocus "right"; }
    bind "Alt j" { MoveFocus "down"; }
    bind "Alt k" { MoveFocus "up"; }
    bind "Alt w" { CloseFocus; SwitchToMode "normal"; }
    bind "Alt t" { SwitchToMode "tab"; }
    bind "Alt Shift t" { NewTab; }
    bind "Alt 0" { GoToTab 10; SwitchToMode "normal"; }
    bind "Alt 1" { GoToTab 1; SwitchToMode "normal"; }
    bind "Alt 2" { GoToTab 2; SwitchToMode "normal"; }
    bind "Alt 3" { GoToTab 3; SwitchToMode "normal"; }
    bind "Alt 4" { GoToTab 4; SwitchToMode "normal"; }
    bind "Alt 5" { GoToTab 5; SwitchToMode "normal"; }
    bind "Alt 6" { GoToTab 6; SwitchToMode "normal"; }
    bind "Alt 7" { GoToTab 7; SwitchToMode "normal"; }
    bind "Alt 8" { GoToTab 8; SwitchToMode "normal"; }
    bind "Alt 9" { GoToTab 9; SwitchToMode "normal"; }
  }

  locked {
    bind "Alt s" { SwitchToMode "normal"; }
  }

  pane {
    bind "Alt q" { SwitchToMode "normal"; }
    bind "Enter" { SwitchToMode "normal"; }
    bind "r" { SwitchToMode "renamepane"; PaneNameInput 0; }
    bind "Shift l" { NewPane "Right"; SwitchToMode "normal"; }
    bind "Shift j" { NewPane "Down"; SwitchToMode "normal"; }
  }

  renamepane {
    bind "Enter" { SwitchToMode "normal"; }
  }

  renametab {
    bind "Enter" { SwitchToMode "normal"; }
  }

  scroll {
    bind "Alt a" { SwitchToMode "normal"; }
    bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
    bind "j" { ScrollDown; }
    bind "k" { ScrollUp; }
    bind "Shift g" { ScrollToBottom; }
    bind "Ctrl g" { ScrollToTop; }
  }

  search {
    bind "c" { SearchToggleOption "CaseSensitivity"; }
    bind "n" { Search "down"; }
    bind "o" { SearchToggleOption "WholeWord"; }
    bind "p" { Search "up"; }
    bind "w" { SearchToggleOption "Wrap"; }
  }

  entersearch {
    bind "Enter" { SwitchToMode "normal"; }
  }

  tab {
    bind "Alt t" { SwitchToMode "normal"; }
    bind "[" { BreakPaneLeft; SwitchToMode "normal"; }
    bind "]" { BreakPaneRight; SwitchToMode "normal"; }
    bind "b" { BreakPane; SwitchToMode "normal"; }
    bind "h" { GoToPreviousTab; }
    bind "j" { GoToNextTab; }
    bind "k" { GoToPreviousTab; }
    bind "l" { GoToNextTab; }
    bind "n" { NewTab; SwitchToMode "normal"; }
    bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
  }
}
