font-family = "JetBrainsMono Nerd Font Mono"
font-family = IPAexMincho
font-size = 14

theme = Monokai Remastered

background = "#1a1a1a"
foreground = "#f6f6ef"
cursor-color = cell-foreground
cursor-text = cell-background


gtk-titlebar = false
mouse-hide-while-typing = true

shell-integration = none
