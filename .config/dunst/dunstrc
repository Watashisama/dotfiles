[global]
monitor = 0
follow = keyboard
width = (250, 500)
height = (0, 750)
offset = (8,8)
origin = bottom-center
padding = 10
horizontal_padding = 10
gap_size = 8
transparency = 0
frame_width = 4
frame_color = "#56f53d"
font = JetBrainsMono Nerd Font Mono 11
corner_radius = 0
min_icon_size = 32
max_icon_size = 320
format = "<b>%s</b>\n%b"
browser = /bin/xdg-open
mouse_left_click = do_action

[urgency_low]
background = "#10171e"
foreground = "##ecf5fe"
timeout = 3

[urgency_normal]
background = "#10171e"
foreground = "##ecf5fe"
timeout = 5

[urgency_critical]
background = "#10171e"
foreground = "##ecf5fe"
frame_color = "#f5503d"
origin = top-right
timeout = 15
